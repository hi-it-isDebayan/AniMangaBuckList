# ------------------------------------------------------------------
# AniMangaBuckList environment variables
# Copy this file to apps/web/.env before running the web app.
# NEVER commit real values.
# ------------------------------------------------------------------

# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Public URL of the app (used for links and OAuth redirects in later phases)
APP_URL=http://localhost:3000

# Metadata provider: "jikan" (default, no auth) or "mal" (MAL REST API)
METADATA_PROVIDER=jikan

# Required when METADATA_PROVIDER=mal.
# Preferred: header-only auth (no user login) via the client id.
MAL_CLIENT_ID=
# Optional: only needed for the interactive OAuth token flow.
MAL_CLIENT_SECRET=
# Alternative (only if you completed the OAuth flow):
#MAL_ACCESS_TOKEN=

# Session lifetime in hours (default 720 = 30 days). Sessions use a sliding TTL.
SESSION_TTL_HOURS=720

# Resend transactional email (required for verification + password reset links).
# Leave blank in dev to see debug links returned in action responses instead.
RESEND_API_KEY=
MAIL_FROM=AniManga BuckList <noreply@animanga.debayandas.in>

# WebAuthn / passkeys (required in production; must match the deployed origin exactly).
# WEBAUTHN_RP_ID must equal the site host; WEBAUTHN_ORIGINS must include the full origin(s).
WEBAUTHN_RP_ID=animanga.debayandas.in
WEBAUTHN_RP_NAME=AniManga BuckList
WEBAUTHN_ORIGINS=https://animanga.debayandas.in