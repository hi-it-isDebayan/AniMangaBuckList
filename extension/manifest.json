{
  "manifest_version": 3,
  "name": "AniManga BuckList Tracker",
  "version": "1.2.2",
  "description": "Auto-tracks anime/manga progress on any site you read or watch.",
  "minimum_chrome_version": "88",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AniManga BuckList Tracker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}